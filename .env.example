# =============================================================================
# Norma Intelligence — Environment Variables (template)
# Copie para .env.local e preencha.
# =============================================================================

# Supabase ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# App --------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="Norma Intelligence"
NODE_ENV=development

# IA / Insights (opcional) -----------------------------------------------------
# Sem essa chave o motor de insights funciona, mas pula a narrativa LLM.
ANTHROPIC_API_KEY=

# Observability (opcional) -----------------------------------------------------
# SENTRY_DSN=
# SENTRY_AUTH_TOKEN=
# AXIOM_TOKEN=
