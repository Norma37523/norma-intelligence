# =============================================================================
# Norma Intelligence — Variáveis de ambiente
# Copie este arquivo para .env.local e preencha os valores.
# NUNCA commite .env.local no git.
# =============================================================================

# ── Supabase ─────────────────────────────────────────────────────────────────
# Encontre em: https://supabase.com/dashboard → seu projeto → Settings → API

NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...anon-key
SUPABASE_SERVICE_ROLE_KEY=eyJ...service-role-key   # só no servidor, nunca exposta ao client

# ── Anthropic (opcional — habilita narrativas financeiras com IA) ─────────────
# Sem essa chave o sistema ainda funciona, mas os insights ficam só estatísticos.
ANTHROPIC_API_KEY=sk-ant-...

# ── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Norma Intelligence
